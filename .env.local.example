# Lumora AI — Environment Variables
#
# Copy this file to `.env.local` for local development:
#   cp .env.local.example .env.local
#
# `.env.local` is git-ignored and must NEVER be committed.
# On Render, set the same keys in the dashboard (see render.yaml).

# ============================================
# Required
# ============================================

# Google Gemini — creative planning, scripting and scene breakdown.
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Pexels — stock video and photo search for scene visuals.
# Get a key at: https://www.pexels.com/api/
# Note: the legacy misspelling PEXELES_API_KEY is still accepted as a fallback.
PEXELS_API_KEY=

# ============================================
# Narration (Piper TTS) — free and fully local
# ============================================
# Piper is invoked as: <PIPER_BINARY> -m piper --model ... 
# No API key is required. The voice model ships in ./voices.

# Path to the Python interpreter that has piper-tts installed.
#   - local Windows dev: python
#   - local macOS/Linux: python3
#   - Render Docker image: python3 (already set in the image)
PIPER_BINARY=python3

# Folder containing <PIPER_MODEL>.onnx and <PIPER_MODEL>.onnx.json
PIPER_VOICE_DIR=./voices

# Voice model name (without extension)
PIPER_MODEL=en_US-amy-medium

# ============================================
# Optional
# ============================================

# Public URL of the deployment, used for absolute links.
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Path to the ffmpeg binary. Leave empty to use `ffmpeg` from PATH.
# FFMPEG_BINARY=
