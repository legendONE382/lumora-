# Lumora AI Environment Variables
# Copy this file to .env.local and fill in your API keys.
# .env.local is ignored by git and should never be committed.

# ============================================
# Required API Keys
# ============================================

# Google AI Studio — used for creative plan generation and scripting
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Pollinations — used for visual and image generation
# Works without a key for low-volume testing.
# Get yours at: https://pollinations.ai
POLLINATIONS_API_KEY=

# ElevenLabs — used for narration/audio generation
# Free tier includes 10,000 characters/month.
# Get yours at: https://elevenlabs.io
ELEVENLABS_API_KEY=

# ============================================
# Optional
# ============================================

# Public-facing app URL used for absolute links or redirects.
# Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Custom FFmpeg binary path. Leave empty to use `ffmpeg` from PATH.
# FFMPEG_BINARY=
